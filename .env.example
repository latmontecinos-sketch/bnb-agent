# Written by `npm run gen-wallet` (never commit .env)
AGENT_PRIVATE_KEY=
# Public base URL of the deployment (no trailing slash)
PUBLIC_BASE_URL=https://YOUR-DOMAIN.vercel.app
# ERC-8004 agentId, filled after registering with tools/register.html
AGENT_ID=
# BSC testnet RPC (chain 97)
RPC_URL=https://data-seed-prebsc-1-s1.bnbchain.org:8545
# Strategy
TARGET_WBNB_PCT=50
DRIFT_THRESHOLD_PCT=1
MAX_TX_BNB=0.02
SLIPPAGE_PCT=1
GAS_RESERVE_BNB=0.005
# Optional: force the stable token (otherwise chosen onchain by WBNB-side liquidity)
STABLE_TOKEN=
# Set to false to never send txs (plan only)
EXECUTION_ENABLED=true
# Min seconds between executed rebalances in one instance
MIN_EXEC_INTERVAL_SEC=300
# Protects /api/cron/rebalance (Authorization: Bearer <secret> or x-cron-secret)
CRON_SECRET=
